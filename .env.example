DATABASE_URL="postgresql://chapa:change-this-local-password@localhost:5432/chapa?schema=public"
APP_URL="http://localhost:3000"
# Public HTTPS origin for a Cloudflare tunnel; leave empty for local-only development.
PUBLIC_SITE_URL=""
# Optional exact additional origins, comma-separated; no wildcard hosts.
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_CONTACT_EMAIL=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Cash-only checkout: keep disabled until the selected gateway is implemented and sandbox-tested.
# AzamPesa/AzamPay credentials must not be substituted for Flutterwave credentials.
PAYMENT_PROVIDER="disabled"
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""
# v3 uses verif-hash. Set hmac only when the configured gateway sends v4 signatures.
FLUTTERWAVE_SIGNATURE_MODE="verif-hash"
ORDER_RESERVATION_MINUTES="60"
# disabled | brevo | resend. Leave disabled until sender/domain verification and an approved test send.
MAIL_PROVIDER="disabled"
BREVO_API_KEY=""
MAIL_FROM_NAME="chapa tronix"
MAIL_REPLY_TO=""
RESEND_API_KEY=""
MAIL_FROM=""
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Persistent local product image directory; defaults to .uploads under the project.
PRODUCT_UPLOAD_DIR=""

# Explicit launch gate: closed (default), test (isolated *_test DB only), live (owner approval required)
SELLING_MODE=closed
ORDER_ACCESS_SECRET=
COD_CONFIRMATION_MINUTES=120
# Docker: use URL-encoded passwords. Web/worker MUST use chapa_runtime, never chapa_migrator.
POSTGRES_BOOTSTRAP_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
DATABASE_MIGRATION_URL=
DATABASE_RUNTIME_URL=

# Audit/integration only: separate local database; never use the business DATABASE_URL.
TEST_DATABASE_URL=""
# Audit runner generates its own run identity and synthetic login credentials.

# SMS: disabled by default. Changing this is a separate approval from email/payments.
# Supported adapters: disabled | beem | custom. mock is isolated-test-only.
SMS_PROVIDER=disabled
SMS_SEND_ENABLED=false
SMS_SENDER_ID=CHAPATRONIX
BEEM_API_KEY=
BEEM_SECRET_KEY=
# Owner's future HTTPS SMS API; see docs/SMS.md for the required contract.
SMS_CUSTOM_URL=
SMS_CUSTOM_API_KEY=
SMS_CUSTOM_WEBHOOK_SECRET=

# Accept cash at delivery or store collection only.
CASH_ONLY=true

# Set true with live sales and cash-only mode to accept orders pending store confirmation.
CASH_ORDERS_OPEN=false
