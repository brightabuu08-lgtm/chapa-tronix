{
  "name": "chapa-tronix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/generate-client.mjs && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "preview:build": "vite build --config vite.preview.config.ts",
    "preview:dev": "vite --config vite.preview.config.ts --host 0.0.0.0",
    "share": "node scripts/start-ngrok-site.mjs",
    "local:setup": "node scripts/setup-local.mjs",
    "local": "node scripts/start-local.mjs",
    "local:dev": "node scripts/start-local.mjs --dev",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "worker:once": "tsx --env-file=.env scripts/worker.ts --once",
    "db:backup": "node --env-file=.env scripts/backup-db.mjs",
    "test:integration": "node tests/run-local-integration.mjs",
    "test:operations": "node tests/run-local-integration.mjs --operations",
    "test:browser": "node tests/store-browser-qa.mjs",
    "lint": "node scripts/lint.mjs",
    "test:review": "node tests/run-review.mjs",
    "test:review:browser": "node tests/review-browser.mjs",
    "test:audit": "node tests/run-audit.mjs",
    "test:sms": "node tests/run-sms.mjs",
    "test:access": "node tests/run-access-all.mjs",
    "production:build": "node scripts/build-production.mjs",
    "production": "node scripts/start-production.mjs"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "zod": "^4.1.0",
    "lucide-react": "^0.468.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/space-grotesk": "^5.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.56.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
